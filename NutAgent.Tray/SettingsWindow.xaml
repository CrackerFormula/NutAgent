<Window x:Class="NutAgent.Tray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NutAgent Settings"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">

        <!-- Mode -->
        <TextBlock Text="Mode" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
            <RadioButton x:Name="ServerRadio" Content="Server" GroupName="Mode"
                         Checked="ServerRadio_Checked" Margin="0,0,16,0"/>
            <RadioButton x:Name="ClientRadio" Content="Client" GroupName="Mode"
                         Checked="ClientRadio_Checked"/>
        </StackPanel>

        <!-- Server settings -->
        <GroupBox x:Name="ServerPanel" Header="Server" Margin="0,10,0,0">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="UPS Name:"
                           VerticalAlignment="Center" Margin="0,0,0,6"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="UpsNameBox"
                           Margin="0,0,0,6"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:"
                           VerticalAlignment="Center"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="PortBox"/>
            </Grid>
        </GroupBox>

        <!-- Client settings -->
        <GroupBox x:Name="ClientPanel" Header="Client" Margin="0,10,0,0"
                  Visibility="Collapsed">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Remote Host:"
                           VerticalAlignment="Center" Margin="0,0,0,6"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="RemoteHostBox"
                           Margin="0,0,0,6"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Remote Port:"
                           VerticalAlignment="Center" Margin="0,0,0,6"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="RemotePortBox"
                           Margin="0,0,0,6"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Remote UPS:"
                           VerticalAlignment="Center"/>
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="RemoteUpsBox"/>
            </Grid>
        </GroupBox>

        <!-- Shutdown thresholds -->
        <GroupBox Header="Shutdown" Margin="0,10,0,0">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="68"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Battery below:"
                           VerticalAlignment="Center" Margin="0,0,0,6"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ChargeThreshBox"
                           TextAlignment="Right" Margin="0,0,4,6"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="%" VerticalAlignment="Center"
                           Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Runtime below:"
                           VerticalAlignment="Center" Margin="0,0,0,6"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="RuntimeThreshBox"
                           TextAlignment="Right" Margin="0,0,4,6"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="minutes"
                           VerticalAlignment="Center" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Shutdown delay:"
                           VerticalAlignment="Center"/>
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="ShutdownDelayBox"
                           TextAlignment="Right" Margin="0,0,4,0"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="seconds"
                           VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,2">
            <Button x:Name="SaveBtn"   Content="Save"   Width="75"
                    IsDefault="True"   Click="Save_Click"/>
            <Button x:Name="CancelBtn" Content="Cancel" Width="75"
                    IsCancel="True"    Margin="8,0,0,0"  Click="Cancel_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
